// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`visual: audit > renders clean audit (no findings) 1`] = `
"kural (kural v0.0.0)

kural · audit
on snapshot: .kural-db/main/active.db
taken on: <DATE>
identified issues: 0
────

[ success ] No structural issues detected

Glossary:

Similarity — cosine similarity between embedding vectors (0–100%)
Dominant / next — highest and second-highest child-to-parent similarity
Identity-content — alignment between a container's name and its actual contents
Axis score — is-does linguistic measurement for descriptions
clusters — groups of semantically similar children suggesting a split
fence — statistical threshold computed from group distribution
group — the peer set used as baseline for comparison

Next steps:

kural audit -f <category> — filter by audit category
kural audit -e — show all findings per audit (no truncation)
kural audit -d <name> — disable specific audits
kural audit -k <n> — adjust sensitivity threshold
kural audit --json — output result as JSON
kural snapshot generate — regenerate snapshot after fixing issues

"
`;

