{
  "name": "kural",
  "version": "0.0.1-alpha.1",
  "description": "Structural scoring system for TypeScript codebases — answers \"where should this code live?\"",
  "keywords": [
    "architecture",
    "audit",
    "code-quality",
    "code-structure",
    "embeddings",
    "scoring",
    "static-analysis",
    "typescript"
  ],
  "homepage": "https://razyones.github.io/kural/",
  "license": "Apache-2.0",
  "author": "Razyones Technologies <vm@razyones.com> (https://www.razyones.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/razyones/kural.git"
  },
  "bin": {
    "kural": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "prepare": "vp config",
    "docs:extract": "node scripts/extract-embeddings.mjs",
    "docs:search-index": "node docs-site/scripts/build-search-index.mjs",
    "docs:dev": "node scripts/extract-embeddings.mjs && node docs-site/scripts/build-search-index.mjs && vp run --filter kural-docs dev",
    "changelog": "node scripts/changelog.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@clack/prompts": "^1.2.0",
    "@poppinss/cliui": "^6.7.0",
    "@saehrimnir/druidjs": "^0.8.0",
    "@tanstack/db": "^0.6.1",
    "@tanstack/node-db-sqlite-persistence": "^0.1.5",
    "ai": "^6.0.116",
    "better-sqlite3": "^12.8.0",
    "gunshi": "^0.29.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@gunshi/docs": "^0.29.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "~5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "nitro>vite": "8"
      }
    },
    "overrides": {
      "kural>vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
      "h3": "2.0.1-rc.20",
      "nitro": "3.0.260311-beta",
      "@tanstack/start-server-core>h3-v2": "npm:h3@2.0.1-rc.20",
      "srvx": ">=0.11.13",
      "picomatch": ">=4.0.4"
    }
  }
}
