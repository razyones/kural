{
  "name": "kural",
  "version": "0.0.1-alpha.1",
  "private": true,
  "bin": {
    "kural": "./dist/cli.mjs"
  },
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "prepare": "vp config",
    "docs:extract": "node scripts/extract-embeddings.mjs",
    "docs:dev": "node scripts/extract-embeddings.mjs && vp run --filter kural-docs dev",
    "docs:build": "node scripts/extract-embeddings.mjs && vp run --filter kural-docs build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@poppinss/cliui": "^6.7.0",
    "@saehrimnir/druidjs": "^0.8.0",
    "@tanstack/db": "^0.6.1",
    "@tanstack/node-db-sqlite-persistence": "^0.1.5",
    "ai": "^6.0.116",
    "better-sqlite3": "^12.8.0",
    "gunshi": "^0.29.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@gunshi/docs": "^0.29.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "~5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "kural>vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
